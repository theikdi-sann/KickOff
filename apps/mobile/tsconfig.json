{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@kickoff/shared": ["../../packages/shared/src/index.ts"],
      "@kickoff/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
