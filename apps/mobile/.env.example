# apps/mobile env template. Copy to .env and fill in.
# EXPO_PUBLIC_* variables are embedded in the JS bundle — anon key only;
# never place service-role or Stripe secrets here (§0 guardrail 12).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me
EXPO_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Enables the "Continue with demo fan account" button. Leave unset to hide it.
EXPO_PUBLIC_DEMO_EMAIL=fan@kickoff.app
EXPO_PUBLIC_DEMO_PASSWORD=replace-me
