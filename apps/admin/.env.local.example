# apps/admin local env template. Copy to .env.local and fill in.
# Values: local Supabase (npm run db:start) until the project is live.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
NEXT_PUBLIC_DEMO_EMAIL=demo@kickoff.test
NEXT_PUBLIC_DEMO_PASSWORD=replace-me

# PostHog product analytics (optional). Leave the key unset to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
