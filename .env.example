# KickOff — root environment template. Copy to .env and fill in.
# NEVER commit real keys. SUPABASE_SERVICE_ROLE_KEY must never reach the
# browser or the mobile bundle (§0 guardrail 12) — it lives only in
# supabase/.env (Edge Function secrets) and CI.

# ── Supabase (project-local dev: run `npm run db:start` and copy the
#    printed local URLs/keys) ─────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ── Stripe (TEST MODE ONLY — §0 guardrail 14) ───────────────────────
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ── QR signing (Edge Function secret; generate with
#    `openssl rand -hex 32`) ──────────────────────────────────────────
TICKET_HMAC_KEY=replace-me

# ── App URLs ────────────────────────────────────────────────────────
ADMIN_APP_URL=http://localhost:3000
MOBILE_DEEP_LINK=kickoff://
FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# ── Demo credentials (seed / demo mode only) ────────────────────────
DEMO_EMAIL=demo@kickoff.test
DEMO_PASSWORD=replace-me
