# supabase/functions env template (local dev). Copy to supabase/.env and
# `supabase functions serve` injects it. In the hosted project these are
# set via `supabase secrets set` — never committed.
# SUPABASE_SERVICE_ROLE_KEY stays here and in CI only (§0 guardrail 12).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Stripe — TEST MODE ONLY (§0 guardrail 14)
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# HMAC key for QR v2 signatures (openssl rand -hex 32)
TICKET_HMAC_KEY=replace-me

# Bearer token guarding the metrics endpoint
METRICS_TOKEN=replace-me

# App URLs
ADMIN_APP_URL=http://localhost:3000
MOBILE_DEEP_LINK=xclub://
