{
  "$schema": "https://deno.land/x/deno@latest/schema.json",
  "imports": {
    "zod": "npm:zod@^4.6.7",
    "stripe": "npm:stripe@^23.1.0",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.119.0",
    "@std/http": "jsr:@std/http@1.1.4",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@1.0.21"
  },
  "tasks": {
    "check": "deno check _shared/*.ts */index.ts",
    "test": "deno test --allow-env --allow-net tests/",
    "lint": "deno lint"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  }
}
