{
  "$schema": "https://deno.land/x/deno@latest/schema.json",
  "imports": {
    "zod": "npm:zod@^4.6.7",
    "stripe": "npm:stripe@^23.1.0",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "@std/http": "jsr:@std/http@1.1.4",
    "@std/testing": "jsr:@std/testing@1.0.21"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  }
}
