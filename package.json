{
  "name": "xclub",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "glob@<14.0.2": "14.0.4",
    "minimatch@>=7.0.0": "^11.0.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @xclub/mobile",
    "mobile:web": "npm run web --workspace @xclub/mobile",
    "admin": "npm run dev --workspace @xclub/admin",
    "dev:admin": "npm run dev --workspace @xclub/admin",
    "dev:mobile": "npm run start --workspace @xclub/mobile",
    "typecheck": "npm run typecheck --workspace @xclub/shared && npm run typecheck --workspace @xclub/mobile && npm run typecheck --workspace @xclub/admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint",
    "check:no-mocks": "bash scripts/check-no-mocks.sh",
    "build:admin": "npm run build --workspace @xclub/admin",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:types": "npx supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:test": "npx supabase test db",
    "functions:serve": "npx supabase functions serve",
    "functions:check": "bash scripts/check-functions.sh"
  }
}
